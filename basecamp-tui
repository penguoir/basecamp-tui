# ---------------------------------------------------------------- CLI calls

class BCError(Exception):
    pass


# `basecamp api` succeeds on the server but chokes rendering a 204's empty body.
EMPTY_BODY = "unexpected end of JSON input"


def bc(*args):
    proc = subprocess.run([BC, *args, "--json"], capture_output=True, text=True)
    try:
        out = json.loads(proc.stdout) if proc.stdout.strip() else {}
    except json.JSONDecodeError:
        raise BCError((proc.stderr or proc.stdout).strip()[:200])
    if proc.returncode != 0 or (isinstance(out, dict) and out.get("ok") is False):
        msg = out.get("error") if isinstance(out, dict) else None
        if args[0] == "api" and msg and EMPTY_BODY in msg:
            return None
        raise BCError(msg or (proc.stderr.strip()[:200]) or f"exit {proc.returncode}")
    return out.get("data") if isinstance(out, dict) and "data" in out else out


def api_path(url):
    # https://3.basecampapi.com/<account>/my/unreads/X.json -> /my/unreads/X.json
    return re.sub(r"^https?://[^/]+/\d+", "", url)


def fetch_page(page):
    return bc("notifications", "list", "--page", str(page)) or {}


def mark_read(sgids):
    bc("api", "put", "/my/unreads.json", "-d", json.dumps({"readables": sgids}))


def mark_unread(n):
    bc("api", "post", api_path(n["unread_url"]), "-d", "{}")


def parse_target(n):
    """bucket, kind, recording id, highlighted sub-recording from app_url."""
    url = n.get("app_url", "")
    if n.get("_target"):
        return n["_target"]
    if re.search(r"/questions/answers/entries/\d+", url):
        return {"bucket": None, "kind": "checkin", "id": None, "focus": None}
    m = re.search(r"/buckets/(\d+)/(.+?)/(\d+)(?:[?#@]|$)", url)
    if not m:
        return None
    frag = re.search(r"(?:#__recording_|@)(\d+)", url)
    return {"bucket": m.group(1), "kind": m.group(2), "id": m.group(3),
            "focus": frag.group(1) if frag else None}


_projects = {}


def resolve_checkin(n):
    """Check-in reminders link to an answer form with no project in the URL; find the
    question by project name + question text and pin it on the notification."""
    if not _projects:
        _projects.update({p["name"]: p["id"] for p in bc("projects", "list", "--all") or []})
    bucket = _projects.get(n.get("bucket_name"))
    if not bucket:
        raise BCError(f"no project named {n.get('bucket_name')!r}")
    questions = bc("checkins", "questions", "--in", str(bucket)) or []
    q = next((q for q in questions if q.get("title") == n.get("title")), None) or (questions or [None])[0]
    if not q:
        raise BCError("no check-in question found in that project")
    n["_target"] = {"bucket": str(bucket), "kind": "questions", "id": str(q["id"]),
                    "focus": None, "checkin": True}
    return n["_target"]


def load_thread(n):
    """Return list of (style, text) blocks for the preview pane."""
    t = parse_target(n)
    blocks = []
    if t and t["kind"] == "checkin":
        t = resolve_checkin(n)
    if not t:
        return [("dim", n.get("content_excerpt") or "(no preview)")]
    if t["kind"] == "chats":
        lines = bc("api", "get", f"/buckets/{t['bucket']}/chats/{t['id']}/lines.json") or []
        lines = sorted(lines, key=lambda l: l.get("created_at", ""))[-40:]
        for ln in lines:
            focus = str(ln.get("id")) == t["focus"]
            blocks.append(("focus" if focus else "author",
                           f"{'▶ ' if focus else ''}{who(ln)} · {age(ln.get('created_at'))}"))
            files = " ".join(f"[📎 {a.get('filename', 'file')}]" for a in ln.get("attachments") or [])
            blocks.append(("body", "\n".join(x for x in (html_to_text(ln.get("content") or ""), files) if x)))
        return blocks or [("dim", "(empty chat)")]

    try:
        rec = bc("show", t["id"], "--in", t["bucket"]) or {}
    except BCError as e:
        return [("dim", n.get("content_excerpt") or ""), ("err", f"(could not load: {e})")]
    title = rec.get("title") or rec.get("subject") or rec.get("name") or n.get("title")
    blocks.append(("title", title or ""))
    meta = [rec.get("type"), who(rec), age(rec.get("created_at"))]
    if rec.get("due_on"):
        meta.append(f"due {rec['due_on']}")
    if rec.get("assignees"):
        meta.append("→ " + ", ".join(a.get("name", "") for a in rec["assignees"]))
    if rec.get("completed"):
        meta.append("✓ completed")
    blocks.append(("dim", " · ".join(x for x in meta if x)))
    # todos keep their title in `content`; everything else keeps the body there
    if rec.get("type") == "Todo":
        body = rec.get("description")
    else:
        body = rec.get("content") or rec.get("description")
    if body and body.strip() != (title or "").strip():
        blocks.append(("body", html_to_text(body)))

    if rec.get("type") == "Question":
        try:
            comments = bc("api", "get", f"/buckets/{t['bucket']}/questions/{t['id']}/answers.json") or []
        except BCError:
            comments = []
        comments = sorted(comments, key=lambda c: c.get("created_at", ""))[-15:] if isinstance(comments, list) else []
    elif rec.get("comments_count") or rec.get("comments_count") is None and t["focus"]:
        try:
            comments = bc("comments", "list", t["id"], "--in", t["bucket"], "--all") or []
        except BCError:
            comments = []
    else:
        comments = []
    for c in comments if isinstance(comments, list) else []:
        if isinstance(c, dict):
            focus = str(c.get("id")) == t["focus"]
            blocks.append(("focus" if focus else "author",
                           f"{'▶ ' if focus else ''}{who(c)} · {age(c.get('created_at'))}"))
            blocks.append(("body", html_to_text(c.get("content") or "")))
    return blocks


_people = []
NOTE = "#! basecamp-tui: "  # editor lines starting with this are instructions, never sent


def people():
    if not _people:
        _people.extend(bc("people", "pingable") or [])
    return _people


def match_person(token):
    """@jane / @ja / @Jane.Smith -> list of candidate people (best tier only)."""
    tok = token.lower().replace(".", " ").replace("_", " ").strip()
    names = [(p, p.get("name", "").lower()) for p in people()]
    for test in (lambda nm: nm == tok,
                 lambda nm: nm.split(" ")[0] == tok,
                 lambda nm: nm.startswith(tok),
                 lambda nm: any(part.startswith(tok) for part in nm.split(" "))):
        hits = [p for p, nm in names if test(nm)]
        if hits:
            return hits
    return []


def resolve_mentions(text, raw_tag=False):
    """Turn @names into Basecamp mentions; returns (text, problems).

    The CLI expands [@Name](mention:SGID) for comments and chat, but not for check-in
    answers, so those get the final <bc-attachment> tag (which its Markdown keeps as-is).
    """
    problems = []

    def sub(m):
        hits = match_person(m.group(1))
        if len(hits) == 1:
            p = hits[0]
            if raw_tag:
                return (f'<bc-attachment sgid="{html.escape(p["attachable_sgid"])}" '
                        f'content-type="application/vnd.basecamp.mention">@{html.escape(p["name"])}</bc-attachment>')
            return f"[@{p['name']}](mention:{p['attachable_sgid']})"
        if not hits:
            problems.append(f"@{m.group(1)} matches nobody")
        else:
            opts = ", ".join("@" + p["name"].replace(" ", ".") for p in hits[:6])
            problems.append(f"@{m.group(1)} is ambiguous: {opts}")
        return m.group(0)

    # not after a word char, so emails stay emails; trailing dots are punctuation
    out = re.sub(r"(?<!\w)@+([A-Za-z][\w.\-]*[\w-]|[A-Za-z])", sub, text)
    return out, problems


def attach_foreground(cmd, cwd):
    """Run `claude attach` as the terminal's foreground job in its own process group.

    Ctrl+Z is how you leave an attached session, but it stops the whole foreground job —
    which would freeze basecamp-tui too. In its own group only the viewer stops; we then close
    the viewer (the session itself keeps running) and take the terminal back.
    """
    fd = sys.stdin.fileno()
    old_ttou = signal.signal(signal.SIGTTOU, signal.SIG_IGN)
    proc = subprocess.Popen(cmd, cwd=cwd, process_group=0)
    try:
        try:
            os.tcsetpgrp(fd, proc.pid)
        except OSError:
            pass  # not a tty (tests); nothing to hand over
        while True:
            _, status = os.waitpid(proc.pid, os.WUNTRACED)
            if not os.WIFSTOPPED(status):
                break
            if os.WSTOPSIG(status) in (signal.SIGTTIN, signal.SIGTTOU):
                os.killpg(proc.pid, signal.SIGCONT)  # read the tty before it was handed over
                continue
            os.killpg(proc.pid, signal.SIGTERM)  # Ctrl+Z: close the viewer
            os.killpg(proc.pid, signal.SIGCONT)
            os.waitpid(proc.pid, 0)
            break
    finally:
        try:
            os.tcsetpgrp(fd, os.getpgrp())
        except OSError:
            pass
        signal.signal(signal.SIGTTOU, old_ttou)


def item_kind(n):
    t = parse_target(n)
    return {"todos": "todo", "card_tables/cards": "card"}.get(t["kind"]) if t else None


COLUMN_TYPE = {"done": "Kanban::DoneColumn", "archive": "Kanban::NotNowColumn"}


def resolve_action(n, action):
    """Look at the item's live state and return (description, do, undo) for done/archive.

    `do`/`undo` are None when the item is already where the action would put it, so we
    never "undo" into a state the user didn't leave it in.
    """
    t = parse_target(n)
    b, rid = t["bucket"], t["id"]
    rec = bc("show", rid, "--in", b) or {}
    title = clip(rec.get("title") or n.get("title", ""), 40)[0]
    if item_kind(n) == "todo":
        if action == "done":
            if rec.get("completed"):
                return f"already completed: {title}", None, None
            return (f"completed “{title}”",
                    lambda: bc("done", rid, "--project", b),
                    lambda: bc("reopen", rid, "--project", b))
        if rec.get("status") == "archived":
            return f"already archived: {title}", None, None
        return (f"archived “{title}”",
                lambda: bc("recordings", "archive", rid, "--in", b),
                lambda: bc("recordings", "restore", rid, "--in", b))

    col = rec.get("parent") or {}
    board = (bc("api", "get", f"/buckets/{b}/card_tables/columns/{col['id']}.json") or {}).get("parent") or {}
    lists = (bc("api", "get", f"/buckets/{b}/card_tables/{board['id']}.json") or {}).get("lists") or []
    target = next((c for c in lists if c.get("type") == COLUMN_TYPE[action]), None)
    if not target:
        raise BCError(f"board “{board.get('title')}” has no {'Done' if action == 'done' else 'Not now'} column")
    if target["id"] == col.get("id"):
        return f"already in {target['title']}: {title}", None, None
    move = lambda to: bc("cards", "move", rid, "--to", str(to), "--in", b)  # noqa: E731
    return (f"moved “{title}” {col.get('title')} → {target['title']}",
            lambda: move(target["id"]), lambda: move(col["id"]))


def who(r):
    return (r.get("creator") or {}).get("name", "")


# ---------------------------------------------------------------- text utils

class _Text(html.parser.HTMLParser):
    BLOCK = {"p", "div", "br", "h1", "h2", "h3", "h4", "blockquote", "pre", "tr", "ul", "ol"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out, self.href, self.depth = [], None, 0
        self.attach = None  # inside <bc-attachment>: None, "mention" or "file"
        self.mention = []

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if self.attach:
            return
        if tag in self.BLOCK:
            self.out.append("\n")
        if tag in ("ul", "ol"):
            self.depth += 1
        elif tag == "li":
            self.out.append("\n" + "  " * max(self.depth - 1, 0) + "• ")
        elif tag == "a":
            self.href = a.get("href")
        elif tag == "bc-attachment":
            if a.get("content-type") == "application/vnd.basecamp.mention":
                self.attach, self.mention = "mention", []
            else:
                self.attach = "file"
                self.out.append(f"[📎 {a.get('caption') or a.get('filename') or 'attachment'}]")
        elif tag == "img":
            self.out.append("[image]")

    def handle_endtag(self, tag):
        if tag == "bc-attachment":
            if self.attach == "mention":
                self.out.append("@" + " ".join("".join(self.mention).split()))
            self.attach = None
            return
        if self.attach:
            return
        if tag in ("ul", "ol"):
            self.depth -= 1
        if tag in self.BLOCK:
            self.out.append("\n")
        elif tag == "a" and self.href:
            text = self.out[-1] if self.out else ""
            if self.href not in text:
                self.out.append(f" <{self.href}>")
            self.href = None

    def handle_data(self, d):
        if self.attach == "mention":
            self.mention.append(d)
        elif not self.attach:
            self.out.append(d)


def html_to_text(s):
    if not s:
        return ""
    if "<" not in s:
        return html.unescape(s).strip()
    p = _Text()
    p.feed(s)
    text = "".join(p.out)
    text = re.sub(r"[ \t]+\n", "\n", text)
    return re.sub(r"\n{3,}", "\n\n", text).strip()


try:
    import ctypes
    import ctypes.util
    _wcwidth = ctypes.CDLL(ctypes.util.find_library("c")).wcwidth
    _wcwidth.argtypes, _wcwidth.restype = [ctypes.c_wchar], ctypes.c_int
except (OSError, AttributeError):
    _wcwidth = None

# Terminals and ncurses disagree about these (emoji presentation, ZWJ sequences),
# which leaves stale cells on screen, so we never draw them.
_INVISIBLE = dict.fromkeys([0x200D, 0xFE0E, 0xFE0F, 0x200B])


def cw(ch):
    if _wcwidth:
        return max(_wcwidth(ch), 0)
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in "WF" else 1


def swidth(s):
    return sum(cw(c) for c in s.translate(_INVISIBLE))


def clip(s, width):
    out, w = [], 0
    for ch in s.translate(_INVISIBLE):
        if ch in "\n\r\t":
            ch = " "
        c = cw(ch)
        if w + c > width:
            break
        out.append(ch)
        w += c
    return "".join(out), w


def wrap(text, width):
    text = text.translate(_INVISIBLE)
    lines = []
    for para in text.split("\n"):
        if not para:
            lines.append("")
            continue
        cur, w = "", 0
        for word in re.split(r"(\s+)", para):
            ww = swidth(word)
            if w + ww > width and cur:
                lines.append(cur.rstrip())
                cur, w = "", 0
                if word.isspace():
                    continue
            while ww > width:  # hard-break very long words / URLs
                head, hw = clip(word, width)
                lines.append(head)
                word = word[len(head):]
                ww = swidth(word)
            cur += word
            w += ww
        lines.append(cur.rstrip())
    return lines


def age(ts):
    if not ts:
        return ""
    try:
        t = datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return ""
    s = (datetime.now(timezone.utc) - t).total_seconds()
    if s < 3600:
        return f"{max(int(s // 60), 0)}m"
    if s < 86400:
        return f"{int(s // 3600)}h"
    if s < 86400 * 14:
        return f"{int(s // 86400)}d"
    return t.strftime("%d %b")


def unread(n):
    return not n.get("read_at") or n["read_at"].startswith("0001")


